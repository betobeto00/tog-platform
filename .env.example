# Puerto HTTP del backend
PORT=3001

# Clave de administrador (para los endpoints /api/admin y /api/empresas)
ADMIN_API_KEY=cambia-esta-clave

# Ruta a la clave privada RSA (la misma pareja de la app TOG Admin:
# la clave pública embebida en src/main/services/license.ts NO cambia).
# Copia keys/private.key del repo tog-admin a /secrets/license_private.pem
LICENSE_PRIVATE_KEY_PATH=./keys/private.key

# --- Stripe ---
# Claves reales de tu cuenta Stripe (modo test primero: sk_test_/whsec_)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Dominio base para las URLs de retorno del checkout (/checkout/success|cancel)
# STRIPE_DOMAIN=https://licencias.tudominio.com
# Precio (Price ID de Stripe) por módulo comprable — el sufijo es el id del módulo:
# STRIPE_PRICE_DISTRIBUIDOR=price_1...
# STRIPE_PRICE_PRODUCTOR=price_1...
# STRIPE_PRICE_PROCESADOR=price_1...
# STRIPE_PRICE_POSTVENTA=price_1...
# En el dashboard de Stripe, configurar el endpoint del webhook como
# https://<host>/api/webhook/stripe y suscribirse al menos a:
# checkout.session.completed, customer.subscription.deleted (y opcionalmente
# invoice.payment_succeeded / invoice.payment_failed para el grace period futuro).