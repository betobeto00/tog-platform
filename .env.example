# Puerto HTTP del backend
PORT=3001

# Clave de administrador (para los endpoints /api/admin y /api/empresas)
ADMIN_API_KEY=cambia-esta-clave

# Secreto para firmar JWTs de autenticación de usuarios
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-jwt

# Ruta a la clave privada RSA (la misma pareja de la app TOG Admin:
# la clave pública embebida en src/main/services/license.ts NO cambia).
# Copia keys/private.key del repo tog-admin a /secrets/license_private.pem
LICENSE_PRIVATE_KEY_PATH=./keys/private.key

# --- Stripe ---
# Claves reales de tu cuenta Stripe (modo test primero: sk_test_/whsec_)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Dominio base para las URLs de retorno del checkout (/checkout/success|cancel)
# STRIPE_DOMAIN=https://licencias.tudominio.com
# Precio (Price ID de Stripe) por módulo comprable — el sufijo es el id del módulo:
# STRIPE_PRICE_DISTRIBUIDOR=price_1...
# STRIPE_PRICE_PRODUCTOR=price_1...
# STRIPE_PRICE_PROCESADOR=price_1...
# STRIPE_PRICE_POSTVENTA=price_1...
# En el dashboard de Stripe, configurar el endpoint del webhook como
# https://<host>/api/webhook/stripe y suscribirse a:
#   checkout.session.completed     → activa la licencia al pagar
#   invoice.payment_succeeded      → renueva la licencia cada mes / reactiva tras impago
#   invoice.payment_failed         → inicia el grace period de 14 días (LICENSE_GRACE_DAYS)
#   customer.subscription.deleted  → cancela la suscripción
# Días de gracia por impago antes de revocar (configurable, default 14):
# LICENSE_GRACE_DAYS=14

# --- Database ---
# Si se define DATABASE_URL, usa PostgreSQL (Supabase).
# Si NO se define, usa SQLite local en data/tog-platform.db (para tests/dev).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email (Resend) ---
# API key de Resend para enviar facturas por correo al confirmar un pago.
# Si no está configurado, las facturas se generan pero no se envían por email.
# RESEND_API_KEY=re_...
# Remitente del email de factura (default: OmniMargen <facturas@omnimargen.site>)
# INVOICE_FROM=OmniMargen <facturas@omnimargen.site>