# Puerto HTTP del backend
PORT=3001

# Clave de administrador (para los endpoints /api/admin y /api/empresas)
ADMIN_API_KEY=cambia-esta-clave

# Secreto para firmar JWTs de autenticación de usuarios
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esta-clave-jwt

# Secreto HMAC que firma los pagos: HMAC-SHA256 de
# `paymentId:monto:empresaId:timestamp`. Sin él el servidor NO arranca.
# Genera uno con: openssl rand -hex 32
PAYMENT_HMAC_SECRET=cambia-este-secreto-hmac

# Ruta a la clave privada RSA (la misma pareja de la app TOG Admin:
# la clave pública embebida en src/main/services/license.ts NO cambia).
# Copia keys/private.key del repo tog-admin a /secrets/license_private.pem
LICENSE_PRIVATE_KEY_PATH=./keys/private.key

# --- Pagos y seguridad (proveedor único: Crixto) ---
# Ventana anti-replay del HMAC, en segundos (default 86400 = 24h, para que un
# pago móvil confirmado horas después siga siendo válido). Bajala a 900 si el
# cobro es siempre inmediato.
# PAYMENT_HMAC_WINDOW_SECONDS=86400
# Máximo de intentos de confirmación por pago y por minuto (default 10):
# PAYMENT_CONFIRM_MAX_PER_MINUTE=10
# Horas tras las cuales un pago `pending` se expira en el job de conciliación:
# PENDING_PAYMENT_TTL_HOURS=24
# Enfriamiento entre cambios de device_fingerprint de una misma empresa:
# DEVICE_CHANGE_COOLDOWN_HOURS=24
# Email que recibe las alertas de seguridad (montos inconsistentes, firmas
# inválidas o vencidas, cambios de dispositivo autorizado):
# SECURITY_ALERT_EMAIL=soporte@omnimargen.site
# URL base para los redirects de retorno del pago (default: https://omnimargen.site)
# SITE_URL=https://omnimargen.site

# --- Rate limiting ---
# Límite global por IP (default 60 req/min). Los límites por ruta
# (payment-status, verify, confirm, omniserv-intent) son fijos y más estrictos.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# --- Database ---
# PRODUCCIÓN (Railway): DATABASE_URL es OBLIGATORIA y apunta al Postgres de
# Supabase. Sin ella el backend arranca igual pero con SQLite en un disco
# EFÍMERO: los datos (empresas, licencias, pagos, 2FA) se pierden en cada
# deploy. Verificá con `railway variables | grep DATABASE_URL`.
# DEV/TESTS: dejala sin definir para usar SQLite local en data/tog-platform.db.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Email (Resend) ---
# API key de Resend para enviar facturas por correo al confirmar un pago.
# Si no está configurado, las facturas se generan pero no se envían por email.
# RESEND_API_KEY=re_...
# Remitente del email de factura (default: OmniMargen <facturas@mail.omnimargen.site>)
# INVOICE_FROM=OmniMargen <facturas@mail.omnimargen.site>
