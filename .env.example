# Puerto HTTP del backend
PORT=3001

# Clave de administrador (para los endpoints /api/admin y /api/empresas)
ADMIN_API_KEY=cambia-esta-clave

# Ruta a la clave privada RSA (la misma pareja de la app TOG Admin:
# la clave pública embebida en src/main/services/license.ts NO cambia).
# Copia keys/private.key del repo tog-admin a /secrets/license_private.pem
LICENSE_PRIVATE_KEY_PATH=./keys/private.key

# --- Stripe (preparado, se activa cuando se integren tarjetas) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...